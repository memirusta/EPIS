{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EPIS",
  "version": "0.2.0",
  "identifier": "com.epis.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:whatsapp-bridge && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EPIS",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../src/agentic/*.py": "python/agentic/",
      "../../../Layer-1/identity/*.md": "Layer-1/identity/",
      "../../src/server/cloud_device_agent.py": "python/server/cloud_device_agent.py",
      "../../src/memory_vault.py": "python/memory_vault.py",
      "../../src/crypto_layer.py": "python/crypto_layer.py",
      "../../src/agentic/whatsapp_auto_conversation.py": "python/agentic/whatsapp_auto_conversation.py",
      "../../whatsapp-bridge/bridge.mjs": "whatsapp-bridge/bridge.mjs",
      "../../whatsapp-bridge/policy.mjs": "whatsapp-bridge/policy.mjs",
      "../../whatsapp-bridge/package.json": "whatsapp-bridge/package.json",
      "../../whatsapp-bridge/node_modules/": "whatsapp-bridge/node_modules/",
      "generated/whatsapp-node/node.exe": "whatsapp-bridge/runtime/node.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
