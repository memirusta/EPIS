{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EPIS",
  "version": "0.2.0",
  "identifier": "com.epis.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EPIS",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../src/agentic/*.py": "python/agentic/",
      "../../src/server/*.py": "python/server/",
      "../../../Layer-1/identity/*.md": "Layer-1/identity/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
