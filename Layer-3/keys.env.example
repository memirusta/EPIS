# Copy this file to Layer-3/keys.env and fill only what you use.

# External model APIs
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Layer 1 backend
LAYER1_BACKEND=qwen
GEMINI_LAYER1_MODEL=
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_MODEL=qwen3.5:9b
QWEN_API_KEY=not-needed
QWEN_THINK=auto
QWEN_MAX_TOKENS_CAP=2048
QWEN_NUM_CTX=16384

# EPIS 0.1 direct OpenAI models. LUNA_BASE_URL is only for an explicit compatible proxy.
LUNA_MODEL=gpt-5.6-luna
LUNA_REASONING_EFFORT=low
LUNA_BASE_URL=
LUNA_API_KEY=
SOL_MODEL=gpt-5.6-sol
SOL_REASONING_EFFORT=high
SOL_API_KEY=
# Safe cloud default: do not send retrieved private memory to frontline inference.
EPIS_LUNA_CONTEXT_MODE=minimal
EPIS_DEVICE_ID=
EPIS_DEVICE_NAME=

# Nightly / external inference
NIGHTLY_STAGE1_MODEL=
NIGHTLY_STAGE2_MODEL=
NIGHTLY_OLLAMA_BASE_URL=
LAYER3_FAST_MODEL=
LAYER3_CODE_MODEL=
LAYER3_VISUAL_MODEL=
LAYER3_MATH_MODEL=
LAYER3_DEEP_MODEL=
LAYER3_GEMINI_FALLBACK=

# Web UI / webhook auth
EPIS_UI_URL=http://127.0.0.1:8080
EPIS_UI_HOST=127.0.0.1
EPIS_UI_PORT=8080
EPIS_UI_SHARED_SECRET=
WEBHOOK_SHARED_SECRET=
PROACTIVE_CHANNEL=ui

# Optional WhatsApp bridge
MY_WHATSAPP_NUMBER=
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
WHATSAPP_MODE=self_chat

# Optional local sensors
GADGETBRIDGE_DB_PATH=
BAND_NOTIFICATIONS=false
BAND_NOTIFY_MODE=adb
ADB_DEVICE=
ADB_PATH=
GADGETBRIDGE_PACKAGE=nodomain.freeyourgadget.gadgetbridge
BAND_NOTIFY_STYLE=epis
PHONE_MONITORING=false

# Encryption / local logging
ENCRYPTION_ENABLED=false
THINKING_LOG=false
